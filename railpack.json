{
  "build": {
    "buildAptPackages": ["sqlite3"],
    "packages": {
      "python": "3.11"
    },
    "commands": [
      "pip install --upgrade pip",
      "pip install -r requirements.txt"
    ]
  },
  "deploy": {
    "startCommand": "python run.py",
    "variables": {
      "LANG": "en_US.UTF-8",
      "LC_ALL": "en_US.UTF-8",
      "PYTHONUNBUFFERED": "1"
    }
  }
}