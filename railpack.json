{
  "$schema": "https://railpack.com/schema.json",
  "build": {
    "buildAptPackages": ["sqlite3", "gcc", "python3-dev"],
    "packages": {
      "python": "3.11.9"
    },
    "commands": [
      "pip install --upgrade pip",
      "pip install -r requirements.txt"
    ]
  },
  "deploy": {
    "startCommand": "python run.py",
    "variables": {
      "LANG": "en_US.UTF-8",
      "LC_ALL": "en_US.UTF-8",
      "PYTHONUNBUFFERED": "1"
    },
    "paths": ["/app/.venv/bin"]
  }
}